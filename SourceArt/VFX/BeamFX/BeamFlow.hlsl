float life = max(Lifetime, .001);
float a = Lifetime > .001 ? saturate((T - Birth) / life) : .35;
float attackEnd = lerp(.13, .018, Inferno);
float fadeStart = lerp(.62, .86, Inferno);
float envelope = smoothstep(0, attackEnd, a) * (1 - smoothstep(fadeStart, 1, a));
float axial = lerp(P.x, P.z-50, Axis) / 50;
float u = axial * .5 + .5;
float v = P.y / 50;
float travel = T * FlowSpeed + Phase;
float flameNoise = sin(u*25 - travel + v*5) * sin(u*43 + travel*.71 - v*8);
float wobble = Inferno * (.13*sin(u*24-travel) + .055*sin(u*51+travel*.8));
float coreMask = pow(saturate(1-abs(v+wobble)), lerp(1.7,1.05,Inferno));
float facing = pow(saturate(abs(dot(normalize(N),normalize(V)))), .7);
float flameEdge = saturate(1-abs(v+wobble)) * smoothstep(-.65,.5,flameNoise);
float outside = facing * lerp(pow(saturate(1-abs(v)),.6), flameEdge, Inferno);
float strands = pow(saturate(.5+.5*sin(u*71-travel*3+sin(v*7+travel*.6))), 9);
float stream = lerp(.78+.22*strands, .45+.55*saturate(.5+.65*flameNoise), Inferno);
float ends = 1-smoothstep(.91,1,abs(axial));
float shape = lerp(outside*stream, coreMask*(.85+.15*strands), Core);
float hot = Core * pow(saturate(1-abs(v+wobble)),5) * .75;
float3 hotColor = lerp(float3(.85,.96,1),float3(1,.88,.53),Inferno);
float3 color = lerp(Tint.rgb,hotColor,hot);
float shimmer = 1 + lerp(.035,.09,Inferno)*sin(T*24+Phase+u*17);
float opacity = saturate(shape*ends*envelope*Opacity);
return float4(color*Energy*shimmer,opacity);
